# ============================================================
# HumanDoc — environment template
# Copy to .env and fill in. Never commit real secrets.
# ============================================================

# ---------- App ----------
APP_NAME=HumanDoc
APP_URL=http://localhost:3000                 # public web origin
API_INTERNAL_URL=http://localhost:8000        # used by Next.js rewrites (docker: http://api:8000)
API_PUBLIC_URL=http://localhost:8000          # used by server-side fetches
CORS_ORIGINS=http://localhost:3000
NODE_ENV=development

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://humandoc:humandoc@localhost:5432/humandoc
# Next.js uses the asyncpg-free form:
DATABASE_URL_PG=postgresql://humandoc:humandoc@localhost:5432/humandoc

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- S3 (AWS S3, MinIO, Cloudflare R2, ...) ----------
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=humandoc
S3_PRESIGN_EXPIRES=900
S3_FORCE_PATH_STYLE=true
# Delete uploads + outputs after N days (default 7)
RETENTION_DAYS=7

# ---------- Auth ----------
# openssl rand -hex 32
SESSION_SECRET=change_me_64_hex_chars
SESSION_TTL_HOURS=720                     # 30 days ("remember me"), 24 otherwise
BCRYPT_COST=12
VERIFY_TOKEN_TTL_MIN=60
RESET_TOKEN_TTL_MIN=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MIN=15

# ---------- Email (Gmail SMTP or Resend) ----------
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=HumanDoc <no-reply@humandoc.local>

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
# pages per month per tier
TIER_FREE_PAGES=20
TIER_STARTER_PAGES=100
TIER_PRO_PAGES=500
TIER_STUDIO_PAGES=2000

# ---------- Anthropic ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS_OUT=1200
ANTHROPIC_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=4
# USD per 1M tokens blended (for the pre-job cost estimate)
PRICE_PER_1M_TOKENS=3.0
FREE_TIER_COST_CAP=0.20

# ---------- Workers ----------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
BATCH_SIZE=5
WORKER_CONCURRENCY=2
JOB_MAX_PAGES=2000
MAX_UPLOAD_MB=500
UPLOAD_PART_MB=20

# ---------- Security ----------
# openssl rand -hex 32 — encrypts job options/QA payloads at rest
FIELD_ENCRYPTION_KEY=change_me_64_hex_chars
VIRUS_SCAN_ENABLED=false
CLAMAV_HOST=
CLAMAV_PORT=3310
RATE_LIMIT_PER_MINUTE=60
