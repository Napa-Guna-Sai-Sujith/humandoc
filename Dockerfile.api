FROM python:3.11-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr libgl1 libglib2.0-0 fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY apps/api ./
RUN pip install --upgrade pip && pip install -e .
RUN mkdir -p /tmp/humandoc
EXPOSE 8000
CMD ["sh", "-c", "celery -A app.workers.celery_app worker -l info -Q humandoc,celery -P solo & uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
