{
  "name": "humandoc",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test": "npm run test --workspace apps/web",
    "api": "cd apps/api && uvicorn app.main:app --reload --port 8000",
    "worker": "cd apps/api && celery -A app.workers.celery_app worker -l info -Q humandoc",
    "migrate": "cd apps/api && alembic upgrade head",
    "test:web": "npm run test --workspace apps/web",
    "test:api": "cd apps/api && pytest -q"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
